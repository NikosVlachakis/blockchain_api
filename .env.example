# Copy to .env and fill in the values:  cp .env.example .env
# SESSION_AUTH_KEY, SESSION_ENC_KEY and KEYSTORE_PASSWORD can be generated with ./generate_session_keys.sh

SESSION_AUTH_KEY=<generated-hex-key>
SESSION_ENC_KEY=<generated-hex-key>
KEYSTORE_PASSWORD=<generated-hex-key>
KEYCLOAK_CA_CLIENT_SECRET=<keycloak-client-secret>
KEYCLOAK_TEST_USERNAME=<keycloak-test-username>
KEYCLOAK_TEST_PWD=<keycloak-test-password>

# Environment variables for Docker Compose
# These are used for distributed mode
ATHENA_FABRIC_CA_URL=https://localhost:10055
ATHENA_TLS_CA_URL=https://localhost:10054
UB_FABRIC_CA_URL=https://localhost:20055
UB_TLS_CA_URL=https://localhost:20054
BSC_FABRIC_CA_URL=https://localhost:30055
BSC_TLS_CA_URL=https://localhost:30054

# Test mode URLs (for filestore testing)
TEST_FABRIC_CA_URL=https://ca_bsc:10055
TEST_TLS_CA_URL=https://tlsca_bsc:10054

BSC_REG_USERNAME=registrar0
BSC_REG_PASSWORD=<registrar-password>
BSC_TEST_USER=<test-user-email>
BSC_TEST_PWD=<test-user-secret>

# Privacy-budget auto-provision after enroll (gap C). Admin must be in the keystore
# (loaded from identities via standard_credentials.json). Secret is the keystore
# password for that identity entry, not the Fabric CA password unless they match.
AUTO_PROVISION_BUDGET=true
BUDGET_ADMIN_ID=admin0
BUDGET_ADMIN_SECRET=<admin0-keystore-password-from-standard_credentials>
SEED_DATASETS=test-dataset
SEED_QUERY_COST=0.1
SEED_EPSILON=10.0
CHANNEL_ID=dt4h
CHAINCODE_ID=dt4hCC

TLSCA_ADMIN=tlsadmin
TLSCA_ADMIN_PWD=<tlsca-admin-password>
